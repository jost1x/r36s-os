# Experimental R36S bring-up profile for Armbian Build Framework.
# This is deliberately WIP until the R36S device tree and boot chain are
# validated on hardware. Do not promote this to .conf/.csc yet.
BOARD_NAME="R36S Panel 4 software profile (experimental)"
BOARD_VENDOR="R36S Hybrid OS"
BOARDFAMILY="rockchip64"
BOARD_MAINTAINER="R36S Hybrid OS contributors"
KERNEL_TARGET="current"
KERNEL_TEST_TARGET="current"
# Keep this board profile on the kernel source that produced the inspected
# 6.18.58 candidate; Armbian's default linux-6.18.y reference moves over time.
KERNELBRANCH="commit:2926d88bb7fc4608fd942453d929c39e4e5ec006"

# Keep the generated cpufrequtils bounds within the PX30 OPP table used by
# rk3326.dtsi. CPUFREQUTILS_ENABLE remains disabled during bring-up.
CPUMIN="600000"
CPUMAX="1296000"

# Apply the base Rockchip64 6.18 patches first, then the project-owned R36S
# Panel 4 device-tree/driver patch.
KERNELPATCHDIR="archive/rockchip64-6.18 r36s-6.18"
enable_extension "r36s-kernel-config"

# R36S board support maintained as source on top of upstream U-Boot v2024.04.
# Pin its reviewed source commit instead of using a prebuilt bootloader blob.
BOOTSOURCE="https://github.com/AndreRenaud/u-boot-r36s.git"
BOOTCONFIG="r36s_defconfig"
BOOTBRANCH_BOARD="commit:afcfed9c686cb8fe90b683050a83e1f62a04e818"
# Apply the upstream v2024.04 fixes, then make the removable SD slot the
# first and only SPL boot source for this eMMC-less board.
BOOTPATCHDIR="v2024.04 r36s"
BOOT_SOC="px30"
# The pinned r36s_defconfig currently leaves ROCKCHIP_EXTERNAL_TPL off, so
# Binman uses the source PX30 TPL. With no LPDDR Kconfig selection, that code
# falls back to its DDR3 333 MHz table; verify the physical DRAM type on-board.
BOOT_SCENARIO="binman-atf-mainline"

# This profile matches the Panel 4 software configuration observed on the
# inspected unit. It does not claim all R36S consoles have the same LCD.
BOOT_FDT_FILE="rockchip/rk3326-r36s-panel4.dtb"

IMAGE_PARTITION_TABLE="msdos"
BOOTFS_TYPE="fat"

# Armbian's generic serial-getty override enables autologin but omits an
# explicit speed. The R36S kernel console is ttyS2 at 1.5 Mbaud; pin that
# instance to the same speed so agetty cannot fall back to 9600 when autologin
# skips input-based terminal setup.
function post_family_tweaks__r36s_serial_getty() {
	local dropin="${SDCARD}/etc/systemd/system/serial-getty@ttyS2.service.d/override.conf"
	mkdir -p "$(dirname -- "${dropin}")"
	cat > "${dropin}" <<'EOF'
[Service]
ExecStart=
ExecStart=-/sbin/agetty --noissue --autologin r36s %I 1500000 $TERM
EOF
}

# Create the user and Wi-Fi profile before first boot. The provisioning file
# is local build input and is never tracked by Git.
function post_family_tweaks__r36s_console_access() {
	local provision="${SRC}/userpatches/r36s-provisioning.env"
	local had_xtrace=0
	[[ $- == *x* ]] && had_xtrace=1
	set +x
	if [[ ! -r "${provision}" ]]; then
		display_alert "R36S provisioning file missing" "${provision}" "err"
		return 1
	fi
	source "${provision}"
	if [[ -z "${R36S_WIFI_SSID:-}" || -z "${R36S_WIFI_PASSWORD:-}" || -z "${R36S_USER_PASSWORD:-}" ]]; then
		display_alert "R36S provisioning values missing" "Check local provisioning file" "err"
		return 1
	fi

	chroot_sdcard groupadd --force sudo
	if ! chroot_sdcard id -u r36s >/dev/null 2>&1; then
		chroot_sdcard useradd --create-home --shell /bin/bash --groups sudo r36s
	fi
	chroot_sdcard usermod --append --groups sudo r36s
	printf 'r36s:%s\n' "${R36S_USER_PASSWORD}" | chroot_sdcard chpasswd
	chroot_sdcard passwd --lock root

	# Give wireless interfaces a stable generic name so Netplan does not depend
	# on a USB adapter's MAC-derived wlx name.
	local link_dir="${SDCARD}/etc/systemd/network"
	mkdir -p "${link_dir}"
	cat > "${link_dir}/10-r36s-wifi.link" <<'EOF'
[Match]
Type=wlan

[Link]
NamePolicy=
Name=wlan0
EOF
	chmod 0644 "${link_dir}/10-r36s-wifi.link"

	export R36S_WIFI_SSID R36S_WIFI_PASSWORD
	python3 - "${SDCARD}/etc/netplan/20-r36s-wifi.yaml" <<'PY'
import json
import os
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
ssid = json.dumps(os.environ["R36S_WIFI_SSID"], ensure_ascii=False)
password = json.dumps(os.environ["R36S_WIFI_PASSWORD"], ensure_ascii=False)
path.write_text(
    "network:\n"
    "  version: 2\n"
    "  renderer: networkd\n"
    "  wifis:\n"
    "    wlan0:\n"
    "      dhcp4: true\n"
    "      regulatory-domain: CL\n"
    f"      access-points:\n        {ssid}:\n          password: {password}\n",
    encoding="utf-8",
)
path.chmod(0o600)
PY

	# Skip Armbian's interactive first-login wizard; the user and network are
	# configured in the image already.
	rm -f "${SDCARD}/root/.not_logged_in_yet"
	# Armbian normally makes its MOTD scripts executable during first login.
	# Since this image skips that wizard, preserve the SSH/console login banner.
	printf 'r36s\n' > "${SDCARD}/etc/hostname"
	local ssh_unit="${SDCARD}/usr/lib/systemd/system/ssh.service"
	if [[ ! -e "${ssh_unit}" ]]; then
		ssh_unit="${SDCARD}/lib/systemd/system/ssh.service"
	fi
	if [[ ! -e "${ssh_unit}" ]]; then
		display_alert "openssh-server service missing" "${ssh_unit}" "err"
		return 1
	fi
	local system_wants="${SDCARD}/etc/systemd/system/multi-user.target.wants"
	mkdir -p "${system_wants}"
	ln -sf "${ssh_unit#${SDCARD}}" "${system_wants}/ssh.service"

	local dropin="${SDCARD}/etc/systemd/system/getty@tty1.service.d/override.conf"
	local info_script="${SDCARD}/usr/local/sbin/r36s-console-info"
	local info_service="${SDCARD}/etc/systemd/system/r36s-show-ip.service"
	local motd_service="${SDCARD}/etc/systemd/system/r36s-enable-motd.service"
	local wants="${SDCARD}/etc/systemd/system/multi-user.target.wants"
	mkdir -p "$(dirname -- "${dropin}")"
	cat > "${dropin}" <<'EOF'
[Service]
ExecStart=
ExecStart=-/sbin/agetty --noissue --autologin r36s %I $TERM
Type=idle
EOF
	install -D -m 0755 "${SRC}/userpatches/scripts/r36s-console-info.sh" "${info_script}"
	install -D -m 0644 "${SRC}/userpatches/systemd/r36s-show-ip.service" "${info_service}"
	install -D -m 0644 "${SRC}/userpatches/systemd/r36s-enable-motd.service" "${motd_service}"
	mkdir -p "${wants}"
	ln -sf ../r36s-show-ip.service "${wants}/r36s-show-ip.service"
	ln -sf ../r36s-enable-motd.service "${wants}/r36s-enable-motd.service"
	unset R36S_USER_PASSWORD R36S_WIFI_PASSWORD R36S_WIFI_SSID
	if (( had_xtrace )); then
		set -x
	fi
	return 0
}

# Install the read-only hardware snapshot tool in the candidate rootfs.
function post_family_tweaks__r36s_diagnostics() {
	local source="${SRC}/userpatches/scripts/collect-r36s-diagnostics.sh"
	local destination="${SDCARD}/usr/local/sbin/r36s-diagnostics"
	if [[ ! -r "${source}" ]]; then
		display_alert "R36S diagnostics script missing" "${source}" "err"
		return 1
	fi
	install -D -m 0755 "${source}" "${destination}"
}
