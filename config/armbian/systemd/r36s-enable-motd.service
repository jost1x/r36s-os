[Unit]
Description=Enable Armbian dynamic login message scripts
After=local-fs.target
Before=ssh.service getty@tty1.service serial-getty@ttyS2.service

[Service]
Type=oneshot
ExecStart=/usr/bin/find /etc/update-motd.d -maxdepth 1 -type f -exec /bin/chmod 0755 {} +
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
